{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pocketfinancer.release-manifest/1",
  "title": "PocketFinancer Active SMS Contract Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "release_id",
    "routing_policy",
    "duplicate_window_ms",
    "runtime_policy",
    "artifacts"
  ],
  "properties": {
    "contract": {
      "const": "pocketfinancer.contract-release-manifest/1"
    },
    "release_id": {
      "const": "pocketfinancer.sms-pipeline/1"
    },
    "duplicate_window_ms": {
      "const": 300000
    },
    "routing_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_contract",
        "processing_config_contract",
        "review_contract",
        "processing_result_contract",
        "complete_posted",
        "exception",
        "duplicate",
        "valid_none",
        "prefilter_excluded",
        "transaction_write",
        "retry"
      ],
      "properties": {
        "policy_contract": {
          "const": "pocketfinancer.persistence-policy/1"
        },
        "processing_config_contract": {
          "const": "pocketfinancer.sms-pipeline/1"
        },
        "review_contract": {
          "const": "pocketfinancer.review-case/2"
        },
        "processing_result_contract": {
          "const": "pocketfinancer.processing-result/3"
        },
        "complete_posted": {
          "const": "transactions"
        },
        "exception": {
          "const": "review"
        },
        "duplicate": {
          "const": "review"
        },
        "valid_none": {
          "const": "tombstoned_none"
        },
        "prefilter_excluded": {
          "const": "tombstoned_excluded"
        },
        "transaction_write": {
          "const": "atomic_with_operation_settlement"
        },
        "retry": {
          "const": "new_operation_with_parent_operation_id"
        }
      }
    },
    "runtime_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation_mode",
        "decoding",
        "answer_token_limit",
        "raw_output_utf8_byte_limit",
        "parser_deadline_ms",
        "claim_lease_ms",
        "claim_heartbeat_ms",
        "automatic_retry_limit"
      ],
      "properties": {
        "generation_mode": {
          "const": "DIRECT_NON_THINKING"
        },
        "decoding": {
          "const": "greedy"
        },
        "answer_token_limit": {
          "const": 512
        },
        "raw_output_utf8_byte_limit": {
          "const": 16384
        },
        "parser_deadline_ms": {
          "const": 0
        },
        "claim_lease_ms": {
          "const": 120000
        },
        "claim_heartbeat_ms": {
          "const": 15000
        },
        "automatic_retry_limit": {
          "const": 3
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "contract",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "contract": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
